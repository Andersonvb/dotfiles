syntax on
set number
set relativenumber
set showmatch
colorscheme desert
set mouse=a
set autoindent
set smartindent
set tabstop=2
set shiftwidth=2
set expandtab
set incsearch
set hlsearch
filetype plugin indent on
set path+=**
set clipboard=unnamed
set wildmenu
set wildmode=list:longest,full
set nowrap

nnoremap <silent> <Esc> :nohlsearch<CR>

